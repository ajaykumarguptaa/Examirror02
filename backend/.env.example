PORT=3000
NODE_ENV=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nca_skill
MYSQL_USER=root
MYSQL_PASSWORD=
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_key
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=user
SMTP_PASSWORD=password
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH=./uploads
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}"

# AWS S3 Storage (Enabled automatically in NODE_ENV=production)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=examirror-student-storage-2026
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set ENABLE_S3_IN_DEV=true ONLY if you explicitly want local uploads to sync to live S3 bucket (default is false)
ENABLE_S3_IN_DEV=false
